<!DOCTYPE html>
    <html>
    <head>
        <title></title>
       
    </head>
    <body>
      <input type="button" value="Read" id="btn" />
      <h2> Product List (AJAX) </h2>
      <table>
          <thead>
              <tr>
                  <th> Product ID</th>
                  <th> Product Name</th>
                  <th> Mfg Name </th>
                  <th> Price </th>
              </tr>
          </thead>
       <tbody id="tb">
       </tbody>
    </table>

    <script type="text/javascript" src="~/jquery/jquery.js"> </script>
    <script type="text/javascript">
      $(function(){

            $("#btn").click(function()
            {
                 $.ajax({
                    url:"/Home/getProducts",
                    type:"Get",
                    contentType:"application/json",
                    success:function(result)
                    {
                      //alert(JSON.stringify(result));
                      $("#tb").empty();
                      $.each(result,function(index,item){
                        // alert(index);
                       //  alert(item);
                        let row="<tr><td>"+item.productID +"</td>";
                        row+="<td>"+item.productName +"</td>";
                        row+="<td>" +item.mfgName+"</td>";
                        row+="<td>"+ item.price+"</td></tr>";
                        $("#tb").append(row);
                      });
                    },
                    error:function(err){
                      alert(JSON.stringify(err));
                    }
                 });
            });

          
